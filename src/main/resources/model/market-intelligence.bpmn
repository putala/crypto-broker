    <bpmn:sequenceFlow id="Flow_0lay1wx" name="Nie" sourceRef="Gateway_15as1gi" targetRef="Event_1jz1gzk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isMarketStable = "Low"
</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_01yl33t" name="Tak" sourceRef="Gateway_15as1gi" targetRef="Event_1lu4lfu">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isMarketStable = "High" or isMarketStable = "Medium"

</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Event_1a0f15a" name="Timer 10s">
