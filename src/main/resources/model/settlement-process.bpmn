        <zeebe:taskDefinition type="generate-pdf-new" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0wi9uex</bpmn:incoming>
      <bpmn:outgoing>Flow_1eo3jtp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0wi9uex" sourceRef="Activity_0n74g1s" targetRef="Activity_08eskie" />
    <bpmn:endEvent id="Event_1489cve" name="Zlecenie sfinalizowane">
      <bpmn:incoming>Flow_1eo3jtp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_1z0ls20" name="Manualne zatwierdzenie Compliance">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="isApproved" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xmwx1c</bpmn:incoming>
      <bpmn:outgoing>Flow_1av7gk4</bpmn:outgoing>
    </bpmn:userTask>
