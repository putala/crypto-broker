  <bpmn:process id="settlement-process" name="settlement-process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Rozpocznij rozliczenie">
      <bpmn:outgoing>Flow_0po2pq7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_CheckRisk" name="Czy ryzyko duże?">
      <bpmn:incoming>Flow_0o3j790</bpmn:incoming>
      <bpmn:outgoing>Flow_1o3767c</bpmn:outgoing>
      <bpmn:outgoing>Flow_0xmwx1c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0po2pq7" sourceRef="StartEvent_1" targetRef="Activity_0wug3zn" />
    <bpmn:businessRuleTask id="Activity_0wug3zn" name="Oceń ryzyko">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="market-risk-assessment" resultVariable="riskLevel" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0po2pq7</bpmn:incoming>
      <bpmn:outgoing>Flow_0o3j790</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0o3j790" sourceRef="Activity_0wug3zn" targetRef="Gateway_CheckRisk" />
    <bpmn:sequenceFlow id="Flow_1o3767c" name="Nie" sourceRef="Gateway_CheckRisk" targetRef="Gateway_0dokzmd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskLevel!="High"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0xmwx1c" name="Tak" sourceRef="Gateway_CheckRisk" targetRef="Activity_1z0ls20">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskLevel="High"


</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0n74g1s" name="Aktualizacja portfela klienta">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-wallet-balance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qjmk0g</bpmn:incoming>
      <bpmn:outgoing>Flow_0wi9uex</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1knx56y" name="Wysyłka zlecenia do giełdy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="execute-exchange-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0n8xgey</bpmn:incoming>
      <bpmn:outgoing>Flow_1qjmk0g</bpmn:outgoing>
