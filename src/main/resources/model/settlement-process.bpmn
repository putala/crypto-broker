      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1eo3jtp" sourceRef="Activity_08eskie" targetRef="Event_1489cve" />
    <bpmn:endEvent id="Event_047yjtw" name="Zlecenie odrzucone">
