    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_14blx22" name="Nie" sourceRef="Gateway_1r9kdty" targetRef="Event_047yjtw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isApproved = false
</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:businessRuleTask id="Activity_0al7ea8" name="Oblicz prowizję">
      <bpmn:extensionElements>
